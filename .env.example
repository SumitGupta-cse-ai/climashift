# =============================================================================
# ClimaShift - Environment Configuration (.env.example)
# =============================================================================

# --- AWS Bedrock & Backend Configuration (Server-Side Only) ---
# When these are configured in your server or IAM role, ClimaShift will invoke
# Amazon Bedrock (Claude 3.5 Sonnet) directly.
# Option A: Bedrock API Key / Bearer Token Authentication (Recommended)
# When set, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are NOT required.
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here

# Option B: AWS IAM Credentials (SigV4 Authentication)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=

# Amazon Bedrock Model ID (Claude Sonnet 4.6 in us-east-1)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# --- Optional: Custom Deployed API Gateway Endpoint ---
# If deploying backend Lambda via template.yaml, specify your API Gateway URL here:
# NEXT_PUBLIC_API_GATEWAY_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod/api/parse-work-plan

# --- Application Settings ---
PORT=3000
NODE_ENV=production
