# AWS Infrastructure & Bedrock Configuration (Server-Side Only)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BEDROCK_API_KEY=your_bedrock_api_key_or_iam_role

# DynamoDB & SNS Resource ARNs
DYNAMODB_AUDIT_TABLE=ClimaShift-AuditLogs
SNS_TOPIC_BROADCAST_ARN=arn:aws:sns:ap-south-1:123456789012:ClimaShift-WorkerBroadcast

# Environmental Telemetry Providers
CPCB_API_KEY=your_cpcb_live_data_key
IMD_WEATHER_API_KEY=your_imd_api_key
